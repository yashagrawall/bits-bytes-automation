# ============================================================================
# SOLE Bits & Bytes Automation (IGIT Sarang) — 100% Free Configuration (.env)
# Copy this file to `.env` (`cp .env.example .env`) and fill in your values.
# Zero paid subscriptions are required.
# ============================================================================

# 1. FREE GMAIL SMTP DELIVERY (Required for auto-sending the email with PNGs)
# Create a free 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=sender@example.com
GMAIL_APP_PASSWORD=

# 2. FREE AI MODEL (Local Ollama is used automatically by default at $0)
# When running locally via Docker, it connects to your host Ollama (`gemma4:e2b`).
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b

# Optional: Free Google AI Studio API Key (100% free tier at https://aistudio.google.com/apikey)
# Used ONLY when running in GitHub Actions while your laptop/Ollama is turned off.
GEMINI_API_KEY=
