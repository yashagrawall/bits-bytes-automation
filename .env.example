# SOLE — Bits & Bytes Automation Environment Variables
# Copy this file to `.env` for local runs. NEVER commit `.env` to git.

# Required for sending emails via Gmail SMTP (smtp.gmail.com:587 STARTTLS)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Keep false when GitHub Actions cron is active to prevent duplicate sends.
# Set true ONLY if you disable GitHub Actions and want Docker to send at Tue/Wed/Sat 18:00 IST.
ENABLE_DAEMON_SCHEDULER=false

# Keep false for deterministic, consistent Instagram captions across cloud & local runs.
ENABLE_LLM_CAPTIONS=false

# Optional: Gemini API key (used only if ENABLE_LLM_CAPTIONS=true)
GEMINI_API_KEY=

# Optional: Local Ollama configuration (used only if ENABLE_LLM_CAPTIONS=true)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b
